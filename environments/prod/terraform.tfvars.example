############################
# Environment
############################
environment = "prod"

############################
# Proxmox connection
############################
proxmox_endpoint     = "https://pve.prod.example.com:8006/"
proxmox_api_token    = "tofu@pve!provisioner=REPLACE-WITH-SECRET"
proxmox_insecure     = false
proxmox_ssh_username = "root"
proxmox_node         = "pve-prod-01"

############################
# Cloud image
############################
image_datastore_id = "local"
datastore_id       = "local-zfs"

############################
# Common cluster defaults
############################
ssh_username = "debian"
ssh_public_keys = [
  "ssh-ed25519 AAAA... your-key-here",
]

############################
# Clusters in this environment
############################
clusters = {
  "k8s-prod-01" = {
    proxmox_node = "pve-prod-01"
    vm_id_base   = 3100

    control_plane = {
      count        = 3
      cpu_cores    = 4
      memory_mb    = 8192
      disk_gb      = 80
      ip_addresses = [
        "10.10.20.10/24",
        "10.10.20.11/24",
        "10.10.20.12/24",
      ]
    }

    workers = {
      count        = 5
      cpu_cores    = 8
      memory_mb    = 16384
      disk_gb      = 200
      ip_addresses = [
        "10.10.20.20/24",
        "10.10.20.21/24",
        "10.10.20.22/24",
        "10.10.20.23/24",
        "10.10.20.24/24",
      ]
    }

    network = {
      bridge      = "vmbr0"
      vlan_id     = 20
      gateway     = "10.10.20.1"
      dns_servers = ["10.10.0.53", "10.10.0.54"]
      dns_domain  = "prod.example.com"
    }
  }
}
